{
    "name": "txv-sh",
    "version": "0.1.0",
    "description": "txv.sh: short links (voidlink) and attested install scripts on Cloudflare Workers",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "bun run links:empty-if-missing && wrangler dev",
        "deploy": "wrangler deploy",
        "check": "tsc --noEmit",
        "lint": "biome check . && bun run lint:sh",
        "lint:sh": "shellcheck sh/*.sh",
        "format": "biome check --write .",
        "test": "bun test",
        "test:unit": "bun test",
        "links": "bun scripts/links.ts",
        "prepare": "lefthook install || echo 'lefthook not installed (run mise install); git hooks skipped'",
        "test:push": "bun run lint && bun run check && bun test",
        "links:empty": "voidlink build --empty --site voidlink.config.ts --out links.gen.json",
        "links:empty-if-missing": "test -f links.gen.json || bun run links:empty"
    },
    "dependencies": {
        "@taraxvoid/voidlink": "0.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@cloudflare/workers-types": "^5.20261006.1",
        "@types/bun": "^1.4.2",
        "typescript": "^5.9.3",
        "wrangler": "^4.147.0"
    }
}
