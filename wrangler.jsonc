{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "txv-sh",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
    "workers_dev": false,
    "observability": {
        "enabled": true
    },
    // Install scripts are bundled as text, byte for byte, so what the Worker
    // serves hashes to what CI attested. bunfig.toml's loader does the same
    // for tests.
    "rules": [
        {
            "type": "Text",
            "globs": ["**/*.sh"],
            "fallthrough": true
        }
    ],
    // The links, built by `voidlink build` from taraxvoid/infra's
    // redirects.ts (CI) or empty (`bun run links:empty`). See src/links.d.ts.
    "alias": {
        "voidlink:links": "./links.gen.json"
    },
    // Click counts only. voidlink creates its tables through this binding,
    // so the deploy runs no migrations and its token needs no D1 grant.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "txv-sh",
            "database_id": "821e3073-2875-4b65-b1b0-083862f08a67"
        }
    ],
    "routes": [
        {
            "pattern": "txv.sh",
            "custom_domain": true
        }
    ],
    // POSTHOG_KEY is a Worker secret: `wrangler secret put POSTHOG_KEY`.
    // Without it redirects still work and nothing is sent. Home URL, utm
    // hosts and the rest are in voidlink.config.ts.
    "vars": {
        "POSTHOG_HOST": "https://us.i.posthog.com"
    }
}
