{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "txv-sh",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
    "workers_dev": false,
    "observability": { "enabled": true },
    // Install scripts are bundled as text, byte for byte, so what the Worker
    // serves hashes to what CI attested. bunfig.toml's loader does the same
    // for tests.
    "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
    // Provisioned on first deploy (no id needed); CI applies migrations.
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "txv-sh",
            "migrations_dir": "migrations"
        }
    ],
    "routes": [{ "pattern": "txv.sh", "custom_domain": true }],
    // POSTHOG_KEY is a Worker secret: `wrangler secret put POSTHOG_KEY`.
    // Without it redirects still work and nothing is sent.
    "vars": {
        "HOME_URL": "https://taraxvoid.com/",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        // Destinations on these hosts (or their subdomains) get default utm_
        // tags, so the site's own analytics credits txv.sh.
        "UTM_HOSTS": ["taraxvoid.com", "taraxvoid.net"]
    }
}
